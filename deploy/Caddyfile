# TLS in front of the API.
#
# Caddy obtains and renews the certificate itself, so nothing here holds a key and
# nothing has to be remembered in ninety days. The domain comes from the environment
# because a hostname is not a secret but it is different on every deployment.

{$SADORA_DOMAIN} {
	# The API is the only thing published. The admin panel is a separate static build
	# and can live anywhere — including ordinary shared hosting — as long as it is
	# allowed through CORS_ALLOWED_ORIGINS in server/.env.prod.
	#
	# The client IP the rate limiter and the audit log record arrives as X-Forwarded-For.
	# reverse_proxy sets it, and X-Forwarded-Proto, from the actual connection by itself,
	# and replaces whatever a client sent in those headers — so there is nothing to add
	# here, and nothing a caller can spoof. (`header_up` lines at this level are not valid
	# Caddyfile; `caddy validate` in CI now says so before a server does.)
	reverse_proxy api:8080

	encode gzip

	log {
		output stdout
		format console
	}
}
