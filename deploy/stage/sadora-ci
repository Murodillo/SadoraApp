#!/usr/bin/env bash
#
# sadora-ci — everything the CI key is allowed to do on the staging server, and nothing more.
#
# Installed as /usr/local/bin/sadora-ci and bound to the CI key in authorized_keys with
# `command="/usr/local/bin/sadora-ci",restrict`, so that key never gets a shell. It can:
#
#   url                       print the public URLs as JSON
#   deploy <sha> <image>      stdin: GHCR token line, then the release bundle (.tar.gz)
#   publish-apk <sha> <build> stdin: the APK
#   rollback [sha]            stdin (optional): GHCR token line, if the image must be pulled
#   status                    releases, containers, health
#
# What it deliberately cannot do is change the infrastructure: compose files, the Caddyfile
# and this script are installed by a person with tools/deploy_stage.sh. A stolen CI key can
# therefore run a different API image in its unprivileged container, but not mount the
# host into one. The bundle still carries those files, so a PR that changes them is
# reported as drift instead of silently ignored.
#
# Run by root with arguments, it does the same things by hand.

set -euo pipefail
umask 022

ROOT=${SADORA_ROOT:-/opt/sadora}
LOCK=${SADORA_LOCK:-/run/lock/sadora-ci.lock}
KEEP=${SADORA_KEEP:-5}
HEALTH_URL=${SADORA_HEALTH_URL:-http://127.0.0.1:8081/health/ready}
HEALTH_TIMEOUT=${SADORA_HEALTH_TIMEOUT:-240}
MAX_BUNDLE=$((64 * 1024 * 1024))
MAX_APK=$((256 * 1024 * 1024))
SHA_RE='^[0-9a-f]{40}$'
IMAGE_RE='^ghcr\.io/[a-z0-9_.-]+/[a-z0-9_./-]+@sha256:[0-9a-f]{64}$'
GATE_PATH=${SADORA_GATE_PATH:-/usr/local/bin/sadora-ci}
INFRA_FILES=(docker-compose.prod.yml docker-compose.stage.yml deploy/stage/Caddyfile deploy/stage/sadora-ci)

log() { printf '%s\n' "$*" >&2; }
# ::error:: and ::warning:: become annotations on the GitHub run; in a terminal they read fine.
die() { printf '::error::%s\n' "$*" >&2; exit 1; }
warn() { printf '::warning::%s\n' "$*" >&2; }

compose() {
  (cd "$ROOT" && SADORA_ENV_FILE=server/.env.stage docker compose -p sadora \
    -f docker-compose.prod.yml -f docker-compose.stage.yml \
    --env-file server/.env.stage --env-file .release.env "$@")
}

tunnel_url() {
  docker logs "sadora-$1-1" 2>&1 | grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' | tail -1 || true
}

newest_first() { # <dir> <find tests…> → matching paths, most recently modified first
  local dir=$1; shift
  find "$dir" -mindepth 1 -maxdepth 1 "$@" -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-
}

release_value() { # KEY → value from .release.env, empty when there is none yet
  [[ -f $ROOT/.release.env ]] || return 0
  sed -n "s/^$1=//p" "$ROOT/.release.env" | tail -1
}

need_sha() { [[ ${1:-} =~ $SHA_RE ]] || die "expected a full 40-character commit sha, got '${1:-}'"; }

read_token() { # first stdin line, when stdin is not a terminal; empty is allowed
  TOKEN=''
  if [[ ! -t 0 ]]; then IFS= read -r TOKEN || true; fi
}

cmd_url() {
  printf '{"app":"%s","landing":"%s"}\n' "$(tunnel_url tunnel-app)" "$(tunnel_url tunnel-landing)"
}

# A bundle may hold regular files and directories under a few known prefixes. No absolute
# paths, no `..`, no links — tar would follow any of those out of the release directory.
check_bundle() {
  local listing name
  listing=$(tar -tvzPf "$1") || die "the bundle is not a readable .tar.gz"
  if grep -qvE '^[-d]' <<<"$listing"; then die "the bundle contains links or special files"; fi
  while IFS= read -r name; do
    name=${name#./}
    [[ -z $name || $name == . || $name == admin || $name == admin/ ]] && continue
    [[ $name == /* || $name == *..* ]] && die "unsafe path in bundle: $name"
    [[ $name =~ ^(admin/dist|landing|infra)(/|$) || $name == RELEASE ]] || die "unexpected path in bundle: $name"
  done < <(tar -tzPf "$1")
}

report_drift() {
  local rel=$1 file base
  for file in "${INFRA_FILES[@]}"; do
    base=$(basename "$file")
    [[ -f $rel/infra/$base ]] || continue
    if [[ $file == deploy/stage/sadora-ci ]]; then
      cmp -s "$rel/infra/$base" "$GATE_PATH" && continue
    else
      cmp -s "$rel/infra/$base" "$ROOT/$file" && continue
    fi
    warn "$file differs from what the server runs — CI does not change infrastructure; run tools/deploy_stage.sh to apply it"
  done
}

pull_image() {
  local image=$1 cfg owner
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  cfg=$(mktemp -d)
  # The token lives only in this throwaway config, never in root's ~/.docker.
  if [[ -n $TOKEN ]]; then
    owner=$(cut -d/ -f2 <<<"$image")
    printf '%s' "$TOKEN" | DOCKER_CONFIG=$cfg docker login ghcr.io -u "$owner" --password-stdin >/dev/null \
      || { rm -rf "$cfg"; die "GHCR refused the token"; }
  fi
  DOCKER_CONFIG=$cfg docker pull -q "$image" >/dev/null || { rm -rf "$cfg"; die "could not pull $image"; }
  rm -rf "$cfg"
}

backup_db() {
  local dir=$ROOT/backups out
  docker ps --format '{{.Names}}' | grep -qx sadora-postgres-1 || { warn "no database container yet — skipping the backup"; return 0; }
  mkdir -p "$dir"; chmod 700 "$dir"
  out="$dir/$(date -u +%Y%m%dT%H%M%SZ)-${1:0:7}.sql.gz"
  # Flyway only moves forward, so the image can be rolled back but a migration cannot.
  # This dump is what undoes one.
  docker exec sadora-postgres-1 sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB"' | gzip > "$out.part" \
    || { rm -f "$out.part"; die "database backup failed — not deploying"; }
  mv "$out.part" "$out"
  newest_first "$dir" -name '*.sql.gz' | tail -n +11 | xargs -r rm -f
}

swap_dir() { # atomically enough: the web container is restarted right after
  local src=$1 dst=$2
  rm -rf "$dst.new" "$dst.old"
  mkdir -p "$(dirname "$dst")"
  cp -a "$src" "$dst.new"
  [[ -e $dst ]] && mv "$dst" "$dst.old"
  mv "$dst.new" "$dst"
  rm -rf "$dst.old"
}

sync_cors() { # the panel's origin is the tunnel's random hostname; see tools/deploy_stage.sh
  local app line env=$ROOT/server/.env.stage
  app=$(tunnel_url tunnel-app)
  [[ -n $app ]] || { warn "the app tunnel has no URL yet — CORS left as it is"; return 1; }
  line="CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,$app"
  grep -qxF "$line" "$env" && return 1
  if grep -q '^CORS_ALLOWED_ORIGINS=' "$env"; then
    sed -i "s#^CORS_ALLOWED_ORIGINS=.*#$line#" "$env"
  else
    printf '%s\n' "$line" >> "$env"
  fi
  return 0
}

wait_healthy() {
  local sha=$1 deadline body
  deadline=$((SECONDS + HEALTH_TIMEOUT))
  while ((SECONDS < deadline)); do
    body=$(curl -fsS -m 5 "$HEALTH_URL" 2>/dev/null || true)
    [[ $body == *'"status":"ready"'* && $body == *"\"release\":\"$sha\""* ]] && return 0
    sleep 3
  done
  log "last health answer: ${body:-none}"
  return 1
}

activate() { # <release dir> <sha> <image>
  local rel=$1 sha=$2 image=$3 recreate=()
  swap_dir "$rel/admin/dist" "$ROOT/admin/dist"
  swap_dir "$rel/landing" "$ROOT/landing"
  printf 'SADORA_API_IMAGE=%s\nSADORA_RELEASE=%s\n' "$image" "$sha" > "$ROOT/.release.env.new"
  mv "$ROOT/.release.env.new" "$ROOT/.release.env"
  if sync_cors; then recreate=(--force-recreate); fi
  # Only api and web: the tunnels keep their hostnames only as long as nobody recreates them.
  compose up -d --no-build "${recreate[@]}" api web >&2
  docker restart sadora-web-1 >/dev/null   # picks up the swapped static directories
  wait_healthy "$sha"
}

prune_releases() {
  local current previous dir
  current=$(release_value SADORA_RELEASE)
  previous=$(awk '$4 == "ok" {print $2}' "$ROOT/releases/HISTORY" 2>/dev/null | tail -2 | head -1)
  newest_first "$ROOT/releases" -type d -regextype posix-extended -regex '.*/[0-9a-f]{40}' \
    | tail -n +$((KEEP + 1)) | while read -r dir; do
    dir=$(basename "$dir")
    [[ $dir == "$current" || $dir == "$previous" ]] && continue
    docker image rm "$(cat "$ROOT/releases/$dir/IMAGE" 2>/dev/null)" >/dev/null 2>&1 || true
    rm -rf "${ROOT:?}/releases/$dir"
  done
}

cmd_deploy() {
  local sha=${1:-} image=${2:-} work rel prev prev_image
  need_sha "$sha"
  [[ $image =~ $IMAGE_RE ]] || die "expected ghcr.io/<owner>/<name>@sha256:<digest>, got '$image'"
  exec 9>"$LOCK"; flock -w 900 9 || die "another deploy has held the lock for 15 minutes"

  read_token
  mkdir -p "$ROOT/releases"
  work=$(mktemp -d "$ROOT/releases/.incoming.XXXXXX")
  # shellcheck disable=SC2064 # expanded now: the local is gone by the time EXIT fires
  trap "rm -rf '$work'" EXIT
  head -c "$MAX_BUNDLE" > "$work/bundle.tgz"
  [[ -s $work/bundle.tgz ]] || die "no bundle on stdin"
  check_bundle "$work/bundle.tgz"

  rel=$ROOT/releases/$sha
  rm -rf "$rel"; mkdir -p "$rel"
  tar -xzf "$work/bundle.tgz" -C "$rel" --no-same-owner --no-same-permissions
  [[ -f $rel/admin/dist/index.html && -f $rel/landing/index.html ]] || die "the bundle has no admin panel or landing page"
  printf '%s\n' "$image" > "$rel/IMAGE"
  report_drift "$rel"

  log "==> pulling $image"
  pull_image "$image"
  log "==> backing up the database"
  backup_db "$sha"

  prev=$(release_value SADORA_RELEASE)
  prev_image=$(release_value SADORA_API_IMAGE)
  log "==> activating ${sha:0:7} (was ${prev:0:7})"
  if activate "$rel" "$sha" "$image"; then
    printf '%s %s %s ok\n' "$(date -u +%FT%TZ)" "$sha" "$image" >> "$ROOT/releases/HISTORY"
    prune_releases
    log "==> ${sha:0:7} is live"
    return 0
  fi

  printf '%s %s %s failed\n' "$(date -u +%FT%TZ)" "$sha" "$image" >> "$ROOT/releases/HISTORY"
  docker ps -a --filter name=sadora- --format '{{.Names}}\t{{.Status}}' >&2
  if [[ -n $prev && -d $ROOT/releases/$prev ]]; then
    warn "${sha:0:7} did not become healthy — rolling back to ${prev:0:7}"
    activate "$ROOT/releases/$prev" "$prev" "$prev_image" || die "rollback to ${prev:0:7} is not healthy either"
    die "${sha:0:7} did not become healthy; ${prev:0:7} is serving again"
  fi
  die "${sha:0:7} did not become healthy, and there is no earlier CI release to go back to"
}

cmd_rollback() {
  local target=${1:-} current image
  exec 9>"$LOCK"; flock -w 900 9 || die "another deploy holds the lock"
  read_token
  current=$(release_value SADORA_RELEASE)
  if [[ -z $target ]]; then
    target=$(awk -v cur="$current" '$4 == "ok" && $2 != cur {print $2}' "$ROOT/releases/HISTORY" 2>/dev/null | tail -1)
    [[ -n $target ]] || die "no earlier healthy release to roll back to"
  fi
  need_sha "$target"
  [[ -f $ROOT/releases/$target/IMAGE ]] || die "release ${target:0:7} is no longer kept on the server"
  image=$(cat "$ROOT/releases/$target/IMAGE")
  pull_image "$image"
  log "==> rolling back ${current:0:7} → ${target:0:7}"
  activate "$ROOT/releases/$target" "$target" "$image" || die "${target:0:7} did not become healthy"
  printf '%s %s %s ok rollback\n' "$(date -u +%FT%TZ)" "$target" "$image" >> "$ROOT/releases/HISTORY"
  log "==> ${target:0:7} is live"
}

cmd_publish_apk() {
  local sha=${1:-} build=${2:-} dir=$ROOT/downloads tmp name size sum app
  need_sha "$sha"
  [[ $build =~ ^[0-9]{1,9}$ ]] || die "expected a numeric build number, got '$build'"
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.upload.XXXXXX")
  # shellcheck disable=SC2064 # expanded now: the locals are gone by the time EXIT fires
  trap "rm -f '$tmp' '$dir/.latest.json' '$dir/.alias.apk'" EXIT
  head -c "$MAX_APK" > "$tmp"
  size=$(stat -c %s "$tmp")
  ((size > 1024)) || die "no APK on stdin"
  [[ $(head -c 4 "$tmp" | od -An -tx1 | tr -d ' \n') == 504b0304 ]] || die "that is not an APK (no zip header)"

  name="sadora-stage-$build-${sha:0:7}.apk"
  chmod 644 "$tmp"; mv "$tmp" "$dir/$name"
  ln -f "$dir/$name" "$dir/.alias.apk" && mv -f "$dir/.alias.apk" "$dir/sadora-stage.apk"
  sum=$(sha256sum "$dir/$name" | cut -d' ' -f1)
  app=$(tunnel_url tunnel-app)
  printf '{"build":%s,"release":"%s","file":"%s","path":"/download/%s","size":%s,"sha256":"%s","api":"%s","publishedAt":"%s"}\n' \
    "$build" "$sha" "$name" "$name" "$size" "$sum" "$app" "$(date -u +%FT%TZ)" > "$dir/.latest.json"
  chmod 644 "$dir/.latest.json"; mv -f "$dir/.latest.json" "$dir/latest.json"
  newest_first "$dir" -name 'sadora-stage-*-*.apk' | tail -n +$((KEEP + 1)) | xargs -r rm -f
  cat "$dir/latest.json"
}

cmd_status() {
  printf 'release: %s\nimage:   %s\n' "$(release_value SADORA_RELEASE)" "$(release_value SADORA_API_IMAGE)"
  echo "recent:"; tail -5 "$ROOT/releases/HISTORY" 2>/dev/null | sed 's/^/  /' || true
  docker ps -a --filter name=sadora- --format '  {{.Names}}\t{{.Status}}'
  printf 'health:  %s\n' "$(curl -fsS -m 5 "$HEALTH_URL" 2>/dev/null || echo unavailable)"
}

main() {
  local -a argv
  if [[ -n ${SSH_ORIGINAL_COMMAND+set} ]]; then
    # Split on whitespace only — no globbing, no quoting, no shell ever sees it.
    read -r -a argv <<<"$SSH_ORIGINAL_COMMAND"
  else
    argv=("$@")
  fi
  case ${argv[0]:-} in
    url | deploy | publish-apk | rollback | status) ;;
    *) die "usage: sadora-ci url | deploy <sha> <image> | publish-apk <sha> <build> | rollback [sha] | status" ;;
  esac
  local cmd=${argv[0]//-/_}
  case $cmd in
    deploy | rollback | publish_apk)
      # A newer push cancels the CI run, which drops this SSH connection mid-command.
      # Half an activation is worse than either release, so finish regardless: ignore
      # the hangup, and write through `tee -p`, which keeps appending to the log after
      # the pipe back to CI is gone instead of killing the script with SIGPIPE.
      trap '' HUP
      mkdir -p "$ROOT/releases"
      exec > >(tee -p -a "$ROOT/releases/gate.log") 2>&1
      printf '\n--- %s %s\n' "$(date -u +%FT%TZ)" "${argv[*]:0:2}"
      ;;
  esac
  "cmd_$cmd" "${argv[@]:1}"
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
