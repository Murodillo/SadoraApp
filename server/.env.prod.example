# SADORA — production environment, as a template.
#
# Copy to `server/.env.prod` on the production host and fill in the blanks. That copy is
# gitignored and must never be committed: everything left empty below is a secret.
#
# Loaded by `./tools/server_run.sh prod`.
#
# `AppConfig.verifyProductionSafety()` refuses to start the server when SADORA_ENV=PROD
# and any of these is still set the development way — a development build cannot be
# promoted to production by accident:
#   * JWT_SECRET is the public development string, or shorter than 32 characters
#   * OTP_EXPOSE_CODE is true
#   * OTP_FIXED_CODE is set at all

SADORA_ENV=PROD
PORT=8080
HOST=0.0.0.0

# The admin panel's real origin. No localhost, no tunnel — production is not browsed
# from a laptop.
CORS_ALLOWED_ORIGINS=https://admin.sadora.app

# ---------------------------------------------------------------- data

# A managed instance, not the docker-compose stack: that file exists to give a laptop
# something to talk to, and has no backups, no replication and a fixed password.
DB_URL=jdbc:postgresql://<host>:5432/sadora
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=20
# Migrations run on boot. Leave true: the deployed jar and its schema then move as one
# thing, and there is no window where the code is ahead of the database.
DB_MIGRATE=true

REDIS_URL=redis://<host>:6379

# ---------------------------------------------------------------- sign-in

# At least 32 characters, from a password manager or `openssl rand -base64 48`.
# Rotating it signs every user out, so it is generated once and kept.
JWT_SECRET=
JWT_ISSUER=sadora
JWT_AUDIENCE=sadora-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_EXPOSE_CODE=false

# Sign-in cannot work until an SMS provider is wired into OtpService — until then a real
# user requests a code that is never delivered. This is the last blocker before launch.

APPLE_BUNDLE_IDS=uz.sadora.app
# Empty rejects Google sign-in outright, which is better than accepting a token nobody
# can verify.
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------- AI

# A billed key, not the free tier: free-tier keys answer image requests with 429 and
# throttle text. With no key at all the rule engine answers and nothing breaks.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800
# Per million tokens, in USD micros. Keep in step with the model's published price or
# the admin panel's cost figures drift away from the real bill.
AI_INPUT_COST_MICROS=100000
AI_OUTPUT_COST_MICROS=400000

# ---------------------------------------------------------------- push

# Firebase Cloud Messaging, which reaches both platforms — Android directly, iOS through
# the APNs key uploaded to the same Firebase project. Both settings or neither: without
# them the server writes notifications to the log instead of delivering them, which is
# right for a laptop and wrong for production.
#
# FCM_SERVICE_ACCOUNT_FILE points at the JSON Google Cloud generates for a service
# account with the Firebase Messaging role. It is a credential: keep it off git.
# In Docker the api container sees server/secrets/ at /run/secrets/sadora/, so copy the
# JSON to server/secrets/fcm-service-account.json on the server (chmod 600) and set:
#   FCM_PROJECT_ID=sadora-4eec5
#   FCM_SERVICE_ACCOUNT_FILE=/run/secrets/sadora/fcm-service-account.json
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------- payments

# From the merchant agreement. An unconfigured provider is simply not offered at
# checkout, so a half-filled section here quietly removes a payment button.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=Paycom
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ---------------------------------------------------------------- policy

# How long "delete my account" waits before the row is erased for real. A window for a
# person who changes her mind, or asks support to — after it the data is gone and
# nothing in the product can bring it back.
ACCOUNT_ERASURE_GRACE_DAYS=30

POLICY_VERSION=2026-09-03
# Set once an older build must be refused. Empty accepts every version.
MINIMUM_APP_VERSION=

# Set for the very first boot only, then remove: it creates the first Owner account and
# does nothing afterwards. Use a real password and change it after signing in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Where this API is reachable from outside: the base of the doctor page behind a QR code
# and of the OAuth redirect wearable providers send a browser back to.
PUBLIC_BASE_URL=https://api.sadora.app

# Cloud wearables. WHOOP needs a developer app (developer-dashboard.whoop.com); the
# redirect URI must be registered there exactly as written here.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_API_BASE_URL=https://api.prod.whoop.com
# 32 random bytes, base64 — `openssl rand -base64 32`. Encrypts provider tokens at rest.
WEARABLE_TOKEN_KEY=

# Google Play subscriptions. A service account with access to this app in Play Console
# (Users and permissions → invite the account's email → "View financial data" and
# "Manage orders and subscriptions"), its JSON key saved under server/secrets/. Blank
# means Play receipts are refused. App Store receipts need nothing here: they are
# checked against Apple's root certificate bundled with the server.
GOOGLE_PLAY_PACKAGE_NAME=uz.sadora.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
