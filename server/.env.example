# Copy to .env and adjust. Every variable has a development default in AppConfig, so an
# empty file still starts the server against the docker-compose stack.

SADORA_ENV=DEV                    # DEV | STAGE | PROD
PORT=8080
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_URL=jdbc:postgresql://localhost:5432/sadora
DB_USER=sadora
DB_PASSWORD=sadora
DB_POOL_SIZE=10
DB_MIGRATE=true

REDIS_URL=redis://localhost:6379  # unset falls back to an in-process cache (single node)

# Required in production — AppConfig refuses to start with the development default.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=sadora
JWT_AUDIENCE=sadora-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_EXPOSE_CODE=true              # returns the code in the response; refused in PROD

APPLE_BUNDLE_IDS=uz.sadora.app
GOOGLE_CLIENT_IDS=                # comma-separated OAuth client ids; empty rejects Google sign-in

# AI gateway. With no key the chat still works and the rule engine answers, which is
# also what the `ai_model_enabled` flag does when an operator turns it off.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=20             # past this the rules answer instead; the log says "timeout"
AI_MAX_OUTPUT_TOKENS=800
AI_INPUT_COST_MICROS=100000       # USD micros per million input tokens
AI_OUTPUT_COST_MICROS=400000      # USD micros per million output tokens

# Payments. An unconfigured provider is not offered at checkout at all, rather than
# offered and then failing — a button that cannot produce a link is worse than no button.
PAYME_MERCHANT_ID=
PAYME_KEY=                        # Payme authenticates its callbacks with Basic Paycom:<key>
PAYME_LOGIN=Paycom
PAYME_ACCOUNT_FIELD=order_id      # the field name agreed with Payme per merchant
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=                 # the shared secret their MD5 signature is built from
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

POLICY_VERSION=2026-08-01
MINIMUM_APP_VERSION=

# Creates the first Owner account when the admin table is empty. Remove after first boot.
ADMIN_BOOTSTRAP_EMAIL=owner@sadora.uz
ADMIN_BOOTSTRAP_PASSWORD=changeme123
