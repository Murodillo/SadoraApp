# SADORA — development environment.
#
# Committed on purpose: every value here is either a public default or a deliberate
# development convenience, and a new machine should come up without anyone hunting for
# settings. Nothing in this file may ever be reused in production — `AppConfig`
# refuses to start with several of these when SADORA_ENV=PROD.
#
# Loaded by `./tools/server_run.sh dev`.

SADORA_ENV=DEV
PORT=8080
HOST=0.0.0.0

# The admin panel's dev server and its built preview. A public tunnel adds its own
# origin at runtime (see tools/demo_up.sh) rather than being written in here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------- data

# 5433 rather than the usual 5432: another project's Postgres holds 5432 on the primary
# development machine. docker-compose reads SADORA_DB_PORT too, so the two agree.
SADORA_DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:${SADORA_DB_PORT}/sadora
DB_USER=sadora
DB_PASSWORD=sadora
DB_POOL_SIZE=10
DB_MIGRATE=true

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- sign-in

# Public and worthless — this exact string is in the repository, which is why
# `verifyProductionSafety` rejects it outside development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=sadora
JWT_AUDIENCE=sadora-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Raised from the production 5: a demo walkthrough signs the same four numbers in
# repeatedly, and the per-phone cap is what stops it.
OTP_MAX_PER_HOUR=50
OTP_EXPOSE_CODE=true
# No SMS provider is wired up, so every challenge issues this code. It is the single
# most dangerous line in the file and the reason DEV must never face real users.
OTP_FIXED_CODE=123456

APPLE_BUNDLE_IDS=uz.sadora.app
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------- AI

# Left blank here; the key lives in the untracked .env at the repository root and
# tools/server_run.sh passes it through. With no key the rule engine answers instead.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800
AI_INPUT_COST_MICROS=100000
AI_OUTPUT_COST_MICROS=400000

# ---------------------------------------------------------------- payments

# Unconfigured, so neither provider is offered at checkout. The paywall still shows the
# plans and their prices; pressing a pay button reports that it is unavailable.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=Paycom
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ---------------------------------------------------------------- policy

POLICY_VERSION=2026-08-01
MINIMUM_APP_VERSION=

# Creates the first Owner when the admin table is empty. Harmless to leave set here:
# it does nothing once an account exists.
ADMIN_BOOTSTRAP_EMAIL=owner@sadora.uz
ADMIN_BOOTSTRAP_PASSWORD=changeme123
