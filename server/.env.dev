# SADORA — development environment.
#
# Committed on purpose: every value here is either a public default or a deliberate
# development convenience, and a new machine should come up without anyone hunting for
# settings. Nothing in this file may ever be reused in production — `AppConfig`
# refuses to start with several of these when SADORA_ENV=PROD.
#
# Loaded by `./tools/server_run.sh dev`.

SADORA_ENV=DEV
PORT=8080
HOST=0.0.0.0

# The admin panel's dev server and its built preview. A public tunnel adds its own
# origin at runtime (see tools/demo_up.sh) rather than being written in here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------- data

# 5433 rather than the usual 5432: another project's Postgres holds 5432 on the primary
# development machine. docker-compose reads SADORA_DB_PORT too, so the two agree.
SADORA_DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:${SADORA_DB_PORT}/sadora
DB_USER=sadora
DB_PASSWORD=sadora
DB_POOL_SIZE=10
DB_MIGRATE=true

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- sign-in

# Public and worthless — this exact string is in the repository, which is why
# `verifyProductionSafety` rejects it outside development.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=sadora
JWT_AUDIENCE=sadora-app
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Raised from the production 5: a demo walkthrough signs the same four numbers in
# repeatedly, and the per-phone cap is what stops it.
OTP_MAX_PER_HOUR=50
OTP_EXPOSE_CODE=true
# No SMS provider is wired up, so every challenge issues this code. It is the single
# most dangerous line in the file and the reason DEV must never face real users.
OTP_FIXED_CODE=123456

APPLE_BUNDLE_IDS=uz.sadora.app
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------- AI

# Left blank here; the key lives in the untracked .env at the repository root and
# tools/server_run.sh passes it through. With no key the rule engine answers instead.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=800
AI_INPUT_COST_MICROS=100000
AI_OUTPUT_COST_MICROS=400000

# ---------------------------------------------------------------- push

# Firebase Cloud Messaging, which reaches both platforms — Android directly, iOS through
# the APNs key uploaded to the same Firebase project. Both settings or neither: without
# them the server writes notifications to the log instead of delivering them, which is
# right for a laptop and wrong for production.
#
# FCM_SERVICE_ACCOUNT_FILE points at the JSON Google Cloud generates for a service
# account with the Firebase Messaging role. It is a credential: keep it off git.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------- payments

# Unconfigured, so neither provider is offered at checkout. The paywall still shows the
# plans and their prices; pressing a pay button reports that it is unavailable.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=Paycom
PAYME_ACCOUNT_FIELD=order_id
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ---------------------------------------------------------------- policy

# How long "delete my account" waits before the row is erased for real. A window for a
# person who changes her mind, or asks support to — after it the data is gone and
# nothing in the product can bring it back.
ACCOUNT_ERASURE_GRACE_DAYS=30

POLICY_VERSION=2026-09-03
MINIMUM_APP_VERSION=

# Creates the first Owner when the admin table is empty. Harmless to leave set here:
# it does nothing once an account exists.
ADMIN_BOOTSTRAP_EMAIL=owner@sadora.uz
ADMIN_BOOTSTRAP_PASSWORD=changeme123

# Where this API is reachable from outside: the base of the doctor page behind a QR code
# and of the OAuth redirect wearable providers send a browser back to.
PUBLIC_BASE_URL=http://localhost:8080

# Cloud wearables. WHOOP needs a developer app (developer-dashboard.whoop.com); the
# redirect URI must be registered there exactly as written here. The secret and the token
# key go in the untracked .env at the repository root, which server_run.sh reads.
WHOOP_CLIENT_ID=b3346b21-fac5-4b91-a6d7-9a300aba221d
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_API_BASE_URL=https://api.prod.whoop.com
# 32 random bytes, base64 — `openssl rand -base64 32`. Encrypts provider tokens at rest.
WEARABLE_TOKEN_KEY=

# Oura needs an API application (cloud.ouraring.com/oauth/applications) with this redirect
# URI on it. The secret, like WHOOP's, goes in the untracked .env at the repository root.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# Google Play subscriptions. A service account with access to this app in Play Console
# (Users and permissions → invite the account's email → "View financial data" and
# "Manage orders and subscriptions"), its JSON key saved under server/secrets/. Blank
# means Play receipts are refused. App Store receipts need nothing here: they are
# checked against Apple's root certificate bundled with the server.
GOOGLE_PLAY_PACKAGE_NAME=uz.sadora.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
