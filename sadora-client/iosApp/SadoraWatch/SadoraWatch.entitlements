<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the watch's complications; the watch keeps its own copy of the snapshot. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uz.sadora.app.watch</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uz.sadora.shared</string>
	</array>
</dict>
</plist>
