<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App ID needs the App Groups capability with this group, or signing fails. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uz.sadora.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uz.sadora.shared</string>
	</array>
</dict>
</plist>
