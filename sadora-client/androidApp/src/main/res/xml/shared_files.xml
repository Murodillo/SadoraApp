<?xml version="1.0" encoding="utf-8"?>
<!-- What other apps may touch: the cache folder pictures are written to before they are
     shared (a prescription card), and the one the camera app writes a message's photo or
     video into. Nothing else of the app's. -->
<paths>
    <cache-path name="shared" path="shared/" />
    <cache-path name="capture" path="capture/" />
</paths>
