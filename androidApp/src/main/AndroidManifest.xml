<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Without this the app cannot reach the backend at all, and every call fails as a
         connection error that looks exactly like a flaky network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The food scanner deliberately does NOT declare android.permission.CAMERA.
        It never opens the camera itself — it sends ACTION_IMAGE_CAPTURE to the system
        camera app, which holds the permission. Declaring it flips that: Android then
        requires the *sender* to hold it too, and since it is revoked by default the
        intent throws a SecurityException the moment the shutter is tapped. That is
        exactly what happened on an S23 the first time this was tried.

        The gallery needs no permission either: PickVisualMedia returns the one image
        the user picked. The camera itself is optional so the app installs without one.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 13 and later post no notification at all without this, granted at runtime.
         MainActivity asks once the user is past onboarding. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Health Connect: read only, and only these. Each is asked for on the devices
        screen, never at launch, and the list must match RecordTypes in
        HealthConnectPlatform — a permission requested but not declared here is refused
        without a dialog. Google Play also wants every one of them justified in the
        Health apps declaration before the release is reviewed.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <!-- Periods older than the 30 days before the first grant; the cycle wants several. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- The client library needs Android 8; the app installs on 7 and checks the version
         before touching it (HealthConnectPlatform). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Android 11+ hides other packages; without this Health Connect looks uninstalled. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Sadora">

        <!-- Receives push while the app is open; in the background the system draws the
             notification itself, with the icon and channel named below. -->
        <service
            android:name=".push.SadoraMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_id" />

        <!-- Analytics collection starts off and is switched on in code only once she has
             ticked the analytics consent. Screen views are logged by the shared code on
             route changes, so Firebase's Activity-based automatic reporting is off — a
             single-Activity app would otherwise report one screen forever. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />

        <!--
            The activity itself is NOT the launcher entry. The three aliases below are,
            exactly one of them enabled at a time, and that is what lets the icon change
            with the streak: Android has no API for retinting a launcher icon, only for
            enabling and disabling components that declare one.

            MainActivity keeps the MAIN action so that `am start` and the IDE's run
            button still work, but without LAUNCHER it draws no second home-screen entry.
        -->
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>

            <!--
                An invite link: https://sadora.app/r/K7M2QP, and the app's own scheme for
                a share sent through a channel that does not linkify URLs.

                The https filter is not verified with assetlinks.json yet, so Android
                offers a chooser rather than opening the app directly. That is the
                honest state of it: verification needs the signing certificate's
                fingerprint published on the domain, which happens at release.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sadora.app" android:pathPrefix="/r/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sadora" android:host="invite" />
            </intent-filter>

            <!-- The return from a wearable provider's consent page in the browser:
                 sadora://wearables/whoop?status=ok. singleTop below is what makes it
                 arrive in onNewIntent of the running app instead of a second copy. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sadora" android:host="wearables" />
            </intent-filter>
        </activity>

        <!-- The privacy policy behind Health Connect's permission screen. Android 13 and
             older open it with the androidx action; 14 and later through the alias below,
             which only the system may start. -->
        <activity
            android:name=".HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Warm: a streak of a week or more. The one enabled on a fresh install, so a
             new phone starts at the brand's own colours rather than at a cold icon. -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Calm: a shorter run, still going. -->
        <activity-alias
            android:name=".LauncherCalm"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_calm"
            android:roundIcon="@mipmap/ic_launcher_round_calm"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Cold: the app has not been opened in days. Dormant, not broken. -->
        <activity-alias
            android:name=".LauncherCold"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_cold"
            android:roundIcon="@mipmap/ic_launcher_round_cold"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
