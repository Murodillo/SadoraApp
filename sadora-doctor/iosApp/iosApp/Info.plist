<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- App Transport Security blocks cleartext by default. The simulator, or a phone on the
	     desk, reaches a locally running backend over http on the local network, which is
	     not an address that exists anywhere but a developer's machine. Everything else
	     stays https-only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- NSLocalNetworkUsageDescription is not here on purpose: only a Debug build talks to a
	     developer's machine, so the Debug configuration adds it through
	     INFOPLIST_KEY_NSLocalNetworkUsageDescription and a Release build never shows it. -->
	<!-- Only the system's HTTPS, which is exempt; without this every build waits on the
	     export-compliance question in App Store Connect before testers can install it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Empty means production. A TestFlight build aimed at staging sets SADORA_API_HOST. -->
	<key>SadoraApiHost</key>
	<string>$(SADORA_API_HOST)</string>
	<!-- Empty means the simulator's loopback. A debug build for a phone sets
	     SADORA_DEV_HOST to the development machine, which the phone can reach. -->
	<key>SadoraDevHost</key>
	<string>$(SADORA_DEV_HOST)</string>
	<!-- The application's documents, her profile photo, and photos and videos for a
	     patient: iOS terminates the app on presenting the photo library without this. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Diplom va litsenziyangiz rasmini, profil rasmingizni hamda bemorga yuboradigan rasm va videolarni galereyadan tanlaysiz.</string>
	<!-- The Scan tab, the profile photo, and a photo or video for a patient: iOS terminates
	     the app on opening the camera without this. -->
	<key>NSCameraUsageDescription</key>
	<string>Bemor ko'rsatgan SADORA QR kodini skanerlaysiz, profil rasmingizni hamda bemorga rasm va video olasiz.</string>
	<!-- A video recorded for a patient has sound: the camera asks for the microphone, and
	     iOS terminates the app on that request without this. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Bemorga video yozganingizda ovozi ham yoziladi.</string>
	<!-- "Telefonga saqlash" in the viewer, with add-only access: the app can put a photo or
	     a video into Photos and never read the library back. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Xabardagi rasm yoki videoni o'zingiz so'raganingizda galereyaga saqlaydi. SADORA galereyangizni o'qimaydi.</string>
	<!-- The languages the app speaks. The permission texts above are the Uzbek fallback;
	     uz/ru/en.lproj/InfoPlist.strings translate them. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>uz</string>
		<string>ru</string>
		<string>en</string>
	</array>
</dict>
</plist>
