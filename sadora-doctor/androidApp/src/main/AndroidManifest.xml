<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without this the app cannot reach the backend at all, and every call fails as a
         connection error that looks exactly like a flaky network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Scan tab reads a patient's QR code from the live camera. Asked for the first
         time the tab opens, not at install; a phone without a camera still installs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Android 13 and later post no notification at all without this, granted at runtime.
         MainActivity asks once she is signed in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing else: the document and profile photos come through the system photo
         picker, which needs no permission and hands over only the image she picked. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SadoraDoctor">

        <!-- Receives push while the app is open; in the background the system draws the
             notification itself, with the icon and channel named below. Without
             google-services.json there is no Firebase app, and nothing ever reaches it. -->
        <service
            android:name=".push.DoctorMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_id" />

        <!-- The file the phone's camera app writes her profile photo into: one file in the
             cache, shared for the length of the capture and deleted once it is read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
