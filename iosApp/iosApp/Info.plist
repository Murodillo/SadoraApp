<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- App Transport Security blocks cleartext by default. The simulator reaches a
	     locally running backend over http on loopback, which is not an address that
	     exists anywhere but a developer's machine, so the exception cannot reach a
	     real user. Everything else stays https-only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Only the system's HTTPS, which is exempt; without this every build waits on the
	     export-compliance question in App Store Connect before testers can install it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Empty means production. A TestFlight build aimed at staging sets SADORA_API_HOST. -->
	<key>SadoraApiHost</key>
	<string>$(SADORA_API_HOST)</string>
	<!-- The app's own scheme: invite links (sadora://invite/CODE) and the return from a
	     wearable provider's consent page (sadora://wearables/whoop?status=ok). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uz.sadora.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sadora</string>
			</array>
		</dict>
	</array>
	<!-- The food scanner. iOS terminates the app on present without these. -->
	<key>NSCameraUsageDescription</key>
	<string>SADORA ovqat suratini o'qib, taxminiy kaloriya va makrolarni ko'rsatadi.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Galereyadan ovqat suratini tanlab, uni skanerdan o'tkazishingiz mumkin.</string>
</dict>
</plist>