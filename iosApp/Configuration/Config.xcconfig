// The Apple Developer team that signs the build: "Ziyodulla Samatov", the account the
// App Store listing lives under. A team identifier is not a secret — it is printed in
// every signed binary — and pinning it here is what lets a plain Xcode build sign itself.
// Override on the xcodebuild command line to sign with another team.
TEAM_ID=WAAR6RJ42C

PRODUCT_NAME=Sadora
// The App Store identity. It matches the Android applicationId and the server's
// APPLE_BUNDLE_IDS, and cannot be changed once the app has shipped.
PRODUCT_BUNDLE_IDENTIFIER=uz.sadora.app

// The API host a release build talks to; empty means production. A host, not a URL,
// because an xcconfig reads a double slash as a comment. Override on the xcodebuild
// command line.
SADORA_API_HOST=

// The host a DEBUG build talks to; empty means the simulator's own loopback. A build
// meant for a phone on the desk sets it to the development machine — `macbook.local`,
// or a whole `https://` URL for a tunnel. The release knob above is a separate one,
// mirroring Android's `sadora.devHost` and `sadora.apiUrl`.
SADORA_DEV_HOST=

CURRENT_PROJECT_VERSION=3
MARKETING_VERSION=1.1
