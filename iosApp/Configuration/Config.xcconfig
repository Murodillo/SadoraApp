// Set TEAM_ID to the Apple Developer team that will sign the build. Xcode needs it to
// provision the app; it is left empty in the repository because it is account-specific
// and not a secret worth committing.
TEAM_ID=

PRODUCT_NAME=Sadora
// The App Store identity. It matches the Android applicationId and the server's
// APPLE_BUNDLE_IDS, and cannot be changed once the app has shipped.
PRODUCT_BUNDLE_IDENTIFIER=uz.sadora.app

// The API host a release build talks to; empty means production. A host, not a URL,
// because an xcconfig reads a double slash as a comment. Override on the xcodebuild
// command line.
SADORA_API_HOST=

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
