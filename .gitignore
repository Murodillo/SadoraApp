*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/

# Secrets. `server/.env.dev` is committed on purpose — it holds only public development
# defaults — but anything holding real credentials stays out.
.env
server/.env
server/.env.prod
server/.env.stage

# The upload key. Generated once, kept in a password manager, never committed.
androidApp/keystore.properties
androidApp/*.jks
androidApp/*.keystore

# Firebase: the app's config, and the key the server sends push with. The config is not
# a credential by Firebase's own account, but it names the project and carries an API key
# that secret scanning flags in a public repository; the service account key is one.
androidApp/google-services.json
iosApp/iosApp/GoogleService-Info.plist
server/secrets/

# Addresses of the staging server — the repository is public.
deploy/stage/hosts.env
admin/coverage/
__pycache__/
